              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Batch files uploaded successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.files).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "files[]",
              "type": "file",
              "src": []
            },
            {
              "key": "files[]",
              "type": "file",
              "src": []
            },
            {
              "key": "uploadedBy",
              "value": "Postman Batch Suite",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/files/upload-multiple",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files",
            "upload-multiple"
          ]
        },
        "description": "Uploads multiple files (field name: 'files[]' or 'files') into GridFS."
      },
      "response": []
    },
    {
      "name": "4. Upload Validation - No File (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Returns NO_FILE_PROVIDED error code\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.code).to.eql(\"NO_FILE_PROVIDED\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
