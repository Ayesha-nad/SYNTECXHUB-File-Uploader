          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/files/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files",
            "upload"
          ]
        },
        "description": "Tests validation when no file is passed in the multipart request."
      },
      "response": []
    },
    {
      "name": "5. List Files with Pagination & Filters",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Pagination and files array present\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.pagination).to.have.property('totalFiles');",
              "    pm.expect(jsonData.files).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/files?page=1&limit=10&category=all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "category",
              "value": "all"
            }
          ]
        },
        "description": "Lists uploaded files with pagination, search, and category filtering."
      },
      "response": []
    },
    {
      "name": "6. Get File Metadata by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
