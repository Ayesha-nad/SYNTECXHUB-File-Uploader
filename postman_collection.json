{
  "info": {
    "_postman_id": "a9c7b6d1-4e28-4981-8b20-13f5c71e98a1",
    "name": "File Uploader API (Multer + MongoDB GridFS)",
    "description": "Comprehensive Postman test suite for File Uploader API with MongoDB GridFS storage, Multer validation, streaming, metadata, and deletion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Health status is ok\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"ok\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Checks the API and MongoDB connection status."
      },
      "response": []
    },
    {
      "name": "2. Single File Upload (Success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"File uploaded and ID returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.file).to.have.property('id');",
              "    pm.collectionVariables.set(\"fileId\", jsonData.file.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "uploadedBy",
              "value": "Postman Test Suite",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Sample file uploaded via Postman automated test",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/files/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files",
            "upload"
          ]
        },
        "description": "Uploads a single file (field name: 'file') directly into MongoDB GridFS."
      },
      "response": []
    },
    {
      "name": "3. Multi-File Upload (Success)",
      "event": [
        {
          "listen": "test",
          "script": {
